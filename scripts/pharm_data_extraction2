"""
Pharma Portfolio Project — Data Extraction (v3 + pipeline & company size)
==========================================================================
Datasets extracted:
  1. FDA approvals       → fda_approvals_raw.csv     (bulk download, no API key)
  2. R&D spend           → rd_spend_all.csv           (Macrotrends scrape)
  3. Clinical pipeline   → pipeline_size.csv          (ClinicalTrials.gov API)
  4. Company size        → company_size_all.csv       (Macrotrends scrape)

All files saved to ./data/raw/
Datasets 1 & 2 are unchanged from v3 — already working.
Datasets 3 & 4 are new additions.

Rough run times:
  Dataset 1 — ~3 min   (150 MB download)
  Dataset 2 — ~1 min   (15 EDGAR API calls, 0.5s delay each)
  Dataset 3 — ~20 min  (1,125 API calls — run last or separately)
  Dataset 4 — ~1 min   (15 EDGAR API calls, 0.5s delay each)

Requirements:
  pip install requests pandas beautifulsoup4 lxml tqdm
"""

import io, os, json, time, zipfile, requests
import pandas as pd
from tqdm import tqdm

RAW_DIR = os.path.join("data", "raw")
os.makedirs(RAW_DIR, exist_ok=True)

# ─────────────────────────────────────────────────────────────
# SHARED COMPANY LIST — used by all four datasets
# ─────────────────────────────────────────────────────────────
# Format:  TICKER : (macrotrends_slug, clinicaltrials_sponsor_name)
#
# macrotrends_slug      — the URL slug on macrotrends.net
# clinicaltrials_name   — exactly how ClinicalTrials.gov lists the sponsor
#                         (copy-paste sensitive — a typo = zero results)
COMPANIES = {
    "JNJ"  : ("johnson-johnson",           "Johnson & Johnson"),
    "PFE"  : ("pfizer",                    "Pfizer"),
    "MRK"  : ("merck",                     "Merck Sharp & Dohme LLC"),
    "ABBV" : ("abbvie",                    "AbbVie"),
    "LLY"  : ("eli-lilly",                 "Eli Lilly and Company"),
    "BMY"  : ("bristol-myers-squibb",      "Bristol-Myers Squibb"),
    "AMGN" : ("amgen",                     "Amgen"),
    "GILD" : ("gilead-sciences",           "Gilead Sciences"),
    "BIIB" : ("biogen",                    "Biogen"),
    "REGN" : ("regeneron-pharmaceuticals", "Regeneron Pharmaceuticals"),
    "AZN"  : ("astrazeneca",               "AstraZeneca"),
    "NVS"  : ("novartis",                  "Novartis Pharmaceuticals"),
    "RHHBY": ("roche",                     "Hoffmann-La Roche"),
    "SNY"  : ("sanofi",                    "Sanofi"),
    "GSK"  : ("glaxosmithkline",           "GlaxoSmithKline"),
}

# ClinicalTrials.gov API base URL (free, no key needed)
CT_BASE = "https://clinicaltrials.gov/api/v2/studies"

# SEC EDGAR API — free, no key, no scraping, no blocks
# Used for R&D spend, revenue, and market cap (Datasets 2 & 4)
EDGAR_BASE   = "https://data.sec.gov/api/xbrl/companyfacts"
EDGAR_SEARCH = "https://efts.sec.gov/LATEST/search-index?q={}&dateRange=custom&startdt=2000-01-01&enddt=2024-12-31&forms=10-K"
EDGAR_HEADERS = {"User-Agent": "pharma-eda-portfolio moyo@example.com"}
# SEC requires a User-Agent with contact info — use your real email above

# SEC CIK numbers for each company
# CIK = Central Index Key — the SEC's unique ID for every filer
# Find any company's CIK at: https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany
COMPANY_CIKS = {
    "JNJ"  : "0000200406",
    "PFE"  : "0000078003",
    "MRK"  : "0000310158",
    "ABBV" : "0001551152",
    "LLY"  : "0000059478",
    "BMY"  : "0000014272",
    "AMGN" : "0000318154",
    "GILD" : "0000882095",
    "BIIB" : "0000875320",
